# Two checks are off on purpose: modernize-use-auto and
# modernize-loop-convert. They contradict this project's own style, which is
# classic hand-managed C++ (see claude.md) -- explicit types for every
# variable, indexed for loops over vectors. A tool does not get to argue with
# the house style. If the style changes, they come back.
Checks: '
  clang-diagnostic-*,
  clang-analyzer-*,
  readability-*,
  modernize-*,
  performance-*,
  bugprone-*,
  -modernize-macro-to-enum,
  -modernize-use-trailing-return-type,
  -modernize-return-braced-init-list,
  -clang-diagnostic-c++17-extensions,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -readability-braces-around-statements,
  -readability-uppercase-literal-suffix,
  -readability-math-missing-parentheses,
  -readability-function-cognitive-complexity,
  -readability-implicit-bool-conversion,
  -readability-identifier-length,
  -modernize-use-auto,
  -modernize-loop-convert,
  -performance-no-int-to-ptr,
  -modernize-use-nodiscard,
'
